<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_esi_ai" model="ir.module.category">
        <field name="name">ESI Agente IA</field>
        <field name="sequence">50</field>
    </record>
    <record id="privilege_esi_ai" model="res.groups.privilege">
        <field name="name">Agente IA</field>
        <field name="category_id" ref="module_category_esi_ai"/>
    </record>
    <record id="group_esi_ai_user" model="res.groups">
        <field name="name">Usuario Agente IA</field>
        <field name="privilege_id" ref="privilege_esi_ai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_esi_ai_manager" model="res.groups">
        <field name="name">Responsable Agente IA</field>
        <field name="privilege_id" ref="privilege_esi_ai"/>
        <field name="implied_ids" eval="[(4, ref('group_esi_ai_user'))]"/>
    </record>
    <record id="rule_esi_ai_own" model="ir.rule">
        <field name="name">Interacciones propias</field>
        <field name="model_id" ref="model_esi_ai_interaction"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_esi_ai_user'))]"/>
    </record>
    <record id="rule_esi_ai_manager" model="ir.rule">
        <field name="name">Interacciones de compañías permitidas</field>
        <field name="model_id" ref="model_esi_ai_interaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_esi_ai_manager'))]"/>
    </record>
</odoo>
